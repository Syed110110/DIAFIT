{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "db:migrate": "node-pg-migrate up --envPath .env",
    "db:rollback": "node-pg-migrate down --envPath .env",
    "db:import-mongo-users": "tsx src/migrateMongoUsers.ts",
    "db:seed-admin": "tsx src/seedAdmin.ts",
    "db:seed-demo-family": "tsx src/seedDemoFamily.ts",
    "test-db": "tsx src/test-connection.ts",
    "migrate-data": "tsx src/data-migration.ts",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.0",
    "node-cron": "^4.2.1",
    "pg": "^8.23.1",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.19.41",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
